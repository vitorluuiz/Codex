# ---------------------------------------------------------------------------
# Copie para .env (nao commitado) e preencha antes de `docker compose up`.
# ---------------------------------------------------------------------------

# Postgres
POSTGRES_DB=codex
POSTGRES_USER=codex
POSTGRES_PASSWORD=

# Redis
REDIS_PASSWORD=

# Mongo — partidas encerradas (docs/contracts/postgresql/migracao-dados.md secao 5)
MONGO_DB=codex
MONGO_USER=codex
MONGO_PASSWORD=

# Compartilhado entre api / realtime / nextjs — mesmo valor de CodexApi:ServiceToken
API_SERVICE_TOKEN=

ASPNETCORE_ENVIRONMENT=Production
SESSION_COOKIE_NAME=codex_session
REALTIME_ALLOWED_ORIGINS=http://localhost:3000

# Precisa estar definido ANTES do build da imagem web (fica embutido no bundle do browser)
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001/realtime

# ---------------------------------------------------------------------------
# Login social. Cada provedor e opcional: sem ClientId/ClientSecret a rota responde
# 501 OAUTH_PROVIDER_NOT_CONFIGURED e os outros continuam funcionando.
#
# OAUTH_REDIRECT_BASE_URL e a origem do Next (nao a da API), porque o provedor devolve o
# browser em {base}/auth/callback/{provedor}. Precisa bater caractere a caractere com o
# redirect_uri registrado em cada provedor.
#   dev  -> http://localhost:3000
#   prod -> https://playcodex.com.br
# ---------------------------------------------------------------------------
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Um OAuth App do GitHub aceita uma unica callback URL: dev e producao precisam de dois
# aplicativos separados, com pares de credenciais distintos.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Grafana (dashboard de metricas da API em http://localhost:3001)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Geracao assistida por IA (editor de conjuntos)
#   local -> LM Studio no host (porta 1234, endpoint OpenAI-compativel)
#   cloud -> Gemini (/v1beta/openai), OpenRouter, Groq ou OpenAI
# ---------------------------------------------------------------------------
AI_ENABLED=true
AI_DEFAULT_PROVIDER=local
AI_FALLBACK_PROVIDER=
AI_LOCAL_BASE_URL=http://host.docker.internal:1234/v1
AI_LOCAL_API_KEY=lm-studio
AI_LOCAL_MODEL=qwen2.5-7b-instruct
AI_CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_CLOUD_API_KEY=
AI_CLOUD_MODEL=gemini-2.5-flash

