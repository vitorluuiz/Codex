# ---------------------------------------------------------------------------
# REST API (consolidação de dados + Firebase/Firestore por trás)
# Usada apenas no servidor (React Server Components / Server Actions).
# ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:4000/v1

# Token de serviço usado pelo Next para falar com a API em nome do servidor.
# Nunca exposto ao browser.
API_SERVICE_TOKEN=

# ---------------------------------------------------------------------------
# Servidor de WebSocket (tempo real da partida)
# Precisa do prefixo NEXT_PUBLIC_ porque o browser abre a conexão.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001/realtime

# ---------------------------------------------------------------------------
# Sessão
# ---------------------------------------------------------------------------
SESSION_COOKIE_NAME=codex_session
