# Desenvolvimento local. Copie para .env e ajuste se necessário.

PORT=4002
REPORTS_HOST=0.0.0.0

# Mesmo valor de API_SERVICE_TOKEN em realtime/.env, nextjs/.env.local e CodexApi:ServiceToken.
API_SERVICE_TOKEN=

# Segredo criptográfico para derivar os tokens de compartilhamento (shareToken e accessToken).
# Se omitido, usa API_SERVICE_TOKEN.
REPORT_TOKEN_SECRET=

# Banco orientado a documentos (MongoDB) — lê `matches` e grava/lê `match_reports`.
# Vazio = store em memória (para dev local sem Mongo ou testes).
MONGO_URL=mongodb://localhost:27017
MONGO_DB=codex

# Redis para fila de processamento em segundo plano e publicação de `report.ready` para o Realtime.
# Vazio = fila local em memória.
REDIS_URL=redis://:devredispass@localhost:6379
REDIS_CHANNEL_PREFIX=codex:rt:

LOG_LEVEL=info
