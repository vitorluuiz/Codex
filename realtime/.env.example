# ---------------------------------------------------------------------------
# Servico de tempo real (contract/websocket-contract.md)
# Carregue com: node --env-file-if-exists=.env dist/index.js  (script `start`)
# ---------------------------------------------------------------------------

PORT=4001
REALTIME_HOST=0.0.0.0
REALTIME_PATH=/realtime

# ---------------------------------------------------------------------------
# API .NET — usada so para resolver identidade e papel (nunca para mutar nada).
# API_SERVICE_TOKEN e o MESMO valor de CodexApi:ServiceToken da API.
# ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:5282
API_SERVICE_TOKEN=
API_TIMEOUT_MS=5000

SESSION_COOKIE_NAME=codex_session

# ---------------------------------------------------------------------------
# Broker. Vazio = fan-out em memoria, valido para UMA instancia (o processo
# recusa subir assim com NODE_ENV=production).
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_CHANNEL_PREFIX=codex:rt:

# ---------------------------------------------------------------------------
# Seguranca (contract §10). Lista separada por virgula. `*` so fora de producao.
# ---------------------------------------------------------------------------
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
REALTIME_MAX_FRAME_BYTES=8192
REALTIME_RATE_LIMIT_PER_SECOND=20

REALTIME_HELLO_TIMEOUT_MS=5000
REALTIME_ROLE_CACHE_TTL_MS=1000
REALTIME_IDLE_TIMEOUT_MS=45000
REALTIME_SHUTDOWN_GRACE_MS=5000

LOG_LEVEL=debug

# Habilita POST /dev/publish (injeta evento sem a API). Ignorado em producao.
REALTIME_DEV_PUBLISH=0
