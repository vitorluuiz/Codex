{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "CodexApi": {
    "ServiceToken": "",
    "UserSessionDefaultLifetimeHours": 12,
    "UserSessionRememberMeLifetimeDays": 30,
    "GuestParticipantLifetimeHours": 4,
    "RoomCodeAttemptsPerMinute": 30,
    "DisplayUtcOffsetHours": -3,
    "Documents": {
      "ConnectionString": "",
      "DatabaseName": "codex",
      "MaxHistoryEntries": 50
    },
    "OAuth": {
      "RedirectBaseUrl": "",
      "Google": { "ClientId": "", "ClientSecret": "" },
      "Microsoft": { "ClientId": "", "ClientSecret": "" },
      "GitHub": { "ClientId": "", "ClientSecret": "" }
    },
    "Realtime": {
      "RedisConnectionString": "",
      "ChannelPrefix": "codex:rt:",
      "TicketLifetimeSeconds": 30
    },
    "Ai": {
      "Enabled": true,
      "DefaultProvider": "local",
      "FallbackProvider": "cloud",
      "Providers": {
        "local": {
          "BaseUrl": "http://localhost:1234/v1",
          "ApiKey": "lm-studio",
          "Model": "qwen2.5-7b-instruct",
          "TimeoutSeconds": 120,
          "MaxConcurrency": 1,
          "SupportsJsonSchema": true,
          "Temperature": 0.7
        },
        "cloud": {
          "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
          "ApiKey": "",
          "Model": "gemini-3.8-flash",
          "TimeoutSeconds": 45,
          "MaxConcurrency": 16,
          "SupportsJsonSchema": true,
          "Temperature": 0.7
        }
      },
      "PlanProviders": { "Free": "local", "Intermediate": "local", "Pro": "cloud" },
      "Quotas": {
        "Period": "Monthly",
        "Free":         { "Credits": 20,  "DailySuggestions": 30 },
        "Intermediate": { "Credits": 150, "DailySuggestions": 200 },
        "Pro":          { "Credits": 600, "DailySuggestions": 1000 }
      },
      "Costs": { "Phase": 1, "Variation": 1, "QuizOptions": 0 },
      "MaxVariationsPerRequest": 5,
      "InflightLockSeconds": 180
    }
  }
